PORT=5000
MONGODB_URI_DATA=mongodb://localhost:27017/data-opts-api
MONGODB_URI_LOGS=mongodb://localhost:27017/data-opts-logs
POSTGRES_DATABASE=advertisement
POSTGRES_HOST=storage.baania.com
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432
POSTGRES_USERNAME=baania_service_user
# Signing secrets — MUST be strong random values (min 32 chars).
# Generate with: openssl rand -hex 32
# The app refuses to boot in production if these are weak/default/too short.
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=30d
NODE_ENV=development
